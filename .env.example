# Copy to .env.local. Never use NEXT_PUBLIC_ for these keys. Node.js 22+.
# Required for the normal map/search flow:
GEOAPIFY_API_KEY=

# Genuine deployment identity. CONTACT_EMAIL is also used for MET/NWS identification.
SITE_URL=
CONTACT_EMAIL=
MET_USER_AGENT=

# Free/hobby usage. Set commercial when your actual use is commercial.
APP_USAGE=noncommercial
TICKETMASTER_COMMERCIAL_PERMISSION=false
RADAR_COMMERCIAL_PERMISSION=false

# Optional keyed providers (unconfigured sources remain visibly unconnected):
TICKETMASTER_API_KEY=
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=
TFL_APP_KEY=
TOMTOM_API_KEY=
TRANSITLAND_API_KEY=
FIRMS_MAP_KEY=
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=
CLOUDFLARE_RADAR_TOKEN=
# Required for commercial Open-Meteo use; otherwise its non-commercial public endpoint is used.
OPEN_METEO_API_KEY=
# Optional; only `npm run discover -- mobility-auth` needs this. CSV discovery needs no key.
MOBILITY_DATABASE_REFRESH_TOKEN=

# Comma-separated IDs from src/lib/analyzer.ts; `regional` disables all regional feeds.
# Example: gdelt,radar,seatgeek
DISABLED_SOURCES=

# Secrets for YOUR regional feed records. Refer to their variable names using auth.env.
# Leave unused entries blank. These are examples, not a universal regional account.
SOCRATA_APP_TOKEN=
METEOALARM_TOKEN=
GTFS_API_KEY=
DATEX_API_KEY=
CIVIC_API_KEY=

# Publish accurate deployment information on Privacy/Terms before public launch.
# Do not insert guessed values. Confirm your host's retention, regions and agreements.
OPERATOR_NAME=
OPERATOR_ADDRESS=
HOSTING_PROVIDER=
HOSTING_PRIVACY_URL=
HOSTING_REGION=
HOSTING_LOG_RETENTION=
PRIVACY_LEGAL_BASIS=
PRIVACY_TRANSFER_NOTICE=
PRIVACY_AUTHORITY_URL=
LEGAL_EFFECTIVE_DATE=22 September 2026
